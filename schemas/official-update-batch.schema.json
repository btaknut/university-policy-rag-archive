{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["captured_at", "repository_base_commit", "records"],
  "properties": {
    "captured_at": {"type": "string", "format": "date"},
    "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "source_record_id", "document_id", "version_id", "document_type", "title", "attachment_url", "file_size", "sha256"], "properties": {"document_type": {"enum": ["regulation", "guideline"]}, "file_size": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
