{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["document_id", "document_type", "title", "access_level", "version_group_id", "sha256"],
  "properties": {
    "document_id": {"type": "string", "pattern": "^(REG|GDL|RUL|MAN|ETC)-[0-9a-f]{12}$"},
    "document_type": {"enum": ["regulation", "guideline", "rule", "manual", "notice", "form", "reference", "unknown"]},
    "title": {"type": "string", "minLength": 1},
    "access_level": {"enum": ["public", "internal", "restricted", "review_required"]},
    "version_group_id": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
